DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Zona horaria de la tienda (usada para calcular el vencimiento de las reservas)
TIME_ZONE=America/Guatemala


# Número de WhatsApp del negocio, en formato internacional sin signos (ej. 50212345678)
WHATSAPP_NUMBER=50212345678

STORE_NAME=Mi Tienda
STORE_CURRENCY=usd
STORE_CURRENCY_SYMBOL=C$

# Horas que dura una reserva antes de liberarse automáticamente
RESERVATION_HOURS=24

# Base de datos. Deja DB_HOST vacío para usar SQLite local.
# DB_ENGINE=postgresql -> Supabase (Project Settings -> Database -> Connect -> Session pooler).
# DB_ENGINE=mysql       -> MySQL de cPanel (host normalmente "localhost", nombre/usuario con
#                          el prefijo de tu cuenta de cPanel, ej. cpaneluser_tienda).
DB_ENGINE=postgresql
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Solo si usas passenger_wsgi.py en cPanel (sin acceso a terminal): crea este superusuario
# automáticamente la primera vez que arranca la app. Déjalos vacíos para no crear ninguno.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Aviso por correo a la encargada cuando un cliente sube un comprobante de pago.
# Deja EMAIL_HOST_USER vacío para no enviar nada (los correos solo se imprimen
# en la consola). EMAIL_HOST_USER/EMAIL_HOST_PASSWORD son la cuenta de correo
# de cPanel que ENVÍA el aviso; STORE_NOTIFICATION_EMAIL es a dónde llega.
EMAIL_HOST=mail.tudominio.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
STORE_NOTIFICATION_EMAIL=
